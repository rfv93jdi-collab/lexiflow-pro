# LLMost — единый API (документация: https://llmost.ru/docs). Ключ читает только server.ts (не попадает в JS-бандл).
LLMOST_API_KEY="ваш-ключ-llmost"
LLMOST_BASE_URL="https://llmost.ru/api/v1"
LLMOST_MODEL="openai/gpt-4o-mini"

# Опционально: запасной Bearer для llmost.ru (если не задан LLMOST_API_KEY)
GEMINI_API_KEY=""

# Опционально: базовый URL для статики (например /Petrovskaia_VKR/ для GitHub Pages)
# VITE_BASE_URL="/"

# Публичный URL приложения (канонический адрес продакшена)
APP_URL="https://lexiflowpro.ru"
